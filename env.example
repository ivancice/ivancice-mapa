# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Veřejná adresa aplikace (pro odkazy v e-mailech, sdílení a QR kód)
NEXT_PUBLIC_SITE_URL=https://spolek.github.io/ivancice-mapa

# --- Ochrana proti robotům (volitelné, doporučené) ---
# Cloudflare Turnstile – site key. Secret key se zadává v Supabase:
# Authentication → Attack Protection → Enable CAPTCHA protection (Turnstile).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Mapové podklady (volitelné; výchozí OSM + ortofoto ČÚZK) ---
# NEXT_PUBLIC_BASEMAP_TILES=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# NEXT_PUBLIC_BASEMAP_ATTRIBUTION=© přispěvatelé OpenStreetMap
# NEXT_PUBLIC_ORTHO_TILES=https://ags.cuzk.gov.cz/arcgis1/rest/services/ORTOFOTO_WM/MapServer/tile/{z}/{y}/{x}
# NEXT_PUBLIC_ORTHO_ATTRIBUTION=Ortofoto © ČÚZK (CC BY 4.0)

# Podadresář, pokud web neběží v kořeni domény (GitHub Pages: "/ivancice-mapa"); jinak prázdné
NEXT_PUBLIC_BASE_PATH=
